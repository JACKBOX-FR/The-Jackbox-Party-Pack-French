      "n": "tSubject"
    },
    {
      "v": "0,2,3,1 ",
      "t": "S",
      "n": "tMCOrder"
    },
    {
      "v": "soulever une barre au-dessus de sa tête chauve d'un seul mouvement continu ",
      "t": "S",
      "n": "tW3"
    },
    {
      "v": "M. Univers est vraiment brillant ",
      "t": "S",
      "n": "tCat"
    },
    {
      "v": "soulevez une barre jusqu'à sa clavicule, puis au-dessus de sa tête chauve ",
      "t": "S",
      "n": "tRight"
    },
    {
      "v": "soulevez une barre jusqu'à la nuque, puis au-dessus de sa tête chauve ",
